# VoDog local development template. No live secrets; do not commit an actual .env.
# Services do not automatically load this file. Use Node --env-file or your process manager.
# For a complete host setup with matching generated secrets, use infra/prepare.py instead.
DATABASE_URL=postgresql://vodog:replace-password@127.0.0.1:5432/vodog
COOKIE_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://app.example.com
RP_ID=app.example.com
PORT=16880
TEST_USERNAME=admin@example.com
TEST_PASSWORD=replace-with-a-random-password
TEST_USER_ROLE=admin
MEDIA_DEFAULT_NODE_ID=relay-primary
# Both secrets below must match the separately configured media bridge/coturn secrets.
MEDIA_NODES_JSON=[{"id":"relay-primary","controlBaseUrl":"http://127.0.0.1:16881","probeUrl":"https://app.example.com/media/probe","turnUdpUrl":"turn:turn.example.com:3478?transport=udp","turnTlsUrl":"turns:turn.example.com:5349?transport=tcp","mediaSecret":"replace-with-at-least-32-random-characters","turnSecret":"replace-with-at-least-32-random-characters"}]
RECORDING_ROOT=./data/recordings
AI_ENABLED=false
AI_WORKER_READY=false
AI_INTERNAL_TOKEN=
AI_MEDIA_NODE_ID=relay-primary
AI_VOICE_PROVIDERS=xai
PIXEL_ARCHIVE_ENABLED=false
TRANSCRIPTION_ENABLED=false
FCM_ENABLED=false
COMMAND_REPLAY_MIGRATION_ENABLED=false
COMMAND_REPLAY_HORIZON_ENABLED=false
TURNSTILE_ENABLED=false
# Optional absolute paths are supplied by your deployment, not by this template:
# PIXEL_ARCHIVE_ROOT, PIXEL_ARCHIVE_VALIDATOR_PATH, RECORDING_MP3_CACHE_DIR
# Optional provider settings belong to the voice worker's private environment:
# XAI_API_KEY, XAI_AGENT_ID, VOICE_PROVIDER, AI_INTERNAL_TOKEN_FILE
# Android passkeys require the SHA256 hash of YOUR signing certificate:
# ANDROID_PASSKEY_ORIGINS=android:apk-key-hash:<base64url-without-padding>
