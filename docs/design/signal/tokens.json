{
  "name": "Signal",
  "version": "1.0.0",
  "note": "Authoritative semantic tokens for VoDog (Web, iOS, Android, macOS). Light mode uses a tinted ground, never large pure-white areas.",
  "color": {
    "bg":         { "light": "#EEEFF3", "dark": "#0B0E13" },
    "chrome":     { "light": "#F6F6F9", "dark": "#141920" },
    "surface":    { "light": "#FBFBFD", "dark": "#141920" },
    "surface2":   { "light": "#ECEDF1", "dark": "#1B2129" },
    "surface3":   { "light": "#E1E3E9", "dark": "#252C36" },
    "line":       { "light": "#E2E4EA", "dark": "#28303B" },
    "ink":        { "light": "#111827", "dark": "#EDF0F5" },
    "ink2":       { "light": "#424B59", "dark": "#BAC2CE" },
    "ink3":       { "light": "#667080", "dark": "#8F99A7" },
    "brand":      { "light": "#1F5FD1", "dark": "#7AA7FF" },
    "onBrand":    { "light": "#FFFFFF", "dark": "#0B1730" },
    "brandSoft":  { "light": "#E9F0FD", "dark": "#1A2945" },
    "bubbleOut":  { "light": "#1F5FD1", "dark": "#2F64D6" },
    "call":       { "light": "#17824B", "dark": "#3DCC85" },
    "callFill":   { "light": "#1E8A50", "dark": "#1E8A50" },
    "callSoft":   { "light": "#E4F4EA", "dark": "#11301F" },
    "danger":     { "light": "#C2302B", "dark": "#FF7A73" },
    "dangerFill": { "light": "#D33A35", "dark": "#D33A35" },
    "dangerSoft": { "light": "#FCECEB", "dark": "#3A1B1B" },
    "warn":       { "light": "#9A5800", "dark": "#F4BA4E" },
    "warnSoft":   { "light": "#FFF4DE", "dark": "#38290D" },
    "ai":         { "light": "#6941C6", "dark": "#B9A2FF" },
    "aiSoft":     { "light": "#F2EDFD", "dark": "#261F42" }
  },
  "simPalette": {
    "rule": "index = rank of SIM by (slotIndex, id) ascending; unrelated to online state (S57). index >= 8: golden-angle hue, light hsl(h,65%,28%) / dark hsl(h,80%,75%), h=(i*137.508+20)%360",
    "light": ["#2457C5", "#147D78", "#B45309", "#7C3AED", "#BE185D", "#4338CA", "#8A5A2B", "#0E7490"],
    "dark":  ["#66A8FF", "#63D3CC", "#FDBA74", "#C4B5FD", "#F9A8D4", "#A5B4FC", "#E0B48A", "#67E8F9"]
  },
  "status": {
    "online": "filled circle, color call",
    "offline": "hollow circle 1.5px, color ink3",
    "pending": "half-filled circle, color warn"
  },
  "radius": { "tag": 6, "control": 12, "card": 16, "panel": 22, "pill": 999, "macControl": 8 },
  "spacing": [4, 8, 12, 16, 24, 32],
  "type": {
    "largeTitle": { "size": 34, "line": 41, "weight": 700 },
    "pageTitle":  { "size": 22, "line": 28, "weight": 700 },
    "headline":   { "size": 17, "line": 22, "weight": 600 },
    "body":       { "size": 15, "line": 22, "weight": 400 },
    "footnote":   { "size": 13, "line": 18, "weight": 400 },
    "caption":    { "size": 11, "line": 13, "weight": 600, "tracking": 0.06 },
    "number":     { "size": 34, "weight": 500, "feature": "tabular-nums" }
  },
  "touch": { "web": 44, "ios": 44, "android": 48, "macControl": 28, "macRow": 44, "keypad": 72, "callButton": 72, "hangup": 80 },
  "shadow": {
    "cardLight": "0 1px 2px rgba(17,24,39,.04), 0 8px 24px rgba(17,24,39,.05)",
    "cardDark": "0 1px 0 rgba(255,255,255,.03), 0 10px 30px rgba(0,0,0,.35)"
  }
}
