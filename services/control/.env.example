# Copy to .env locally. Never commit real values.
DATABASE_URL=postgres://vodog:change-me@127.0.0.1:5432/vodog
PUBLIC_ORIGIN=https://vodog.example.com
RP_ID=vodog.example.com
COOKIE_SECRET=replace-with-at-least-32-random-characters
TEST_USERNAME=
TEST_PASSWORD=
TEST_USER_ROLE=user
SEED_GATEWAY_ID=
SEED_GATEWAY_TOKEN=
GATEWAY_ONLINE_SECONDS=30
PORT=3100
AI_ENABLED=false
AI_WORKER_READY=false
AI_INTERNAL_TOKEN=
# AI_MEDIA_NODE_ID=relay-primary
MEDIA_SECRET=
TURN_SECRET=
# Optional JSON array of fixed media nodes. Secrets remain environment-only.
MEDIA_DEFAULT_NODE_ID=relay-primary
# MEDIA_NODES_JSON=[{"id":"relay-primary","controlBaseUrl":"http://127.0.0.1:16881","turnUdpUrl":"turn:relay-secondary.example.com:16801?transport=udp","turnTlsUrl":"turns:relay-secondary.example.com:16802?transport=tcp","mediaSecret":"replace-with-32-bytes","turnSecret":"replace-with-32-bytes"}]
RECORDING_ROOT=
TRANSCRIPTION_ENABLED=false
# Required only when explicitly enabling; prevents historical recordings from being queued.
TRANSCRIPTION_ENABLED_AT=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_SCAN_INTERVAL_SECONDS=5
TRANSCRIPTION_SCAN_BATCH=2
